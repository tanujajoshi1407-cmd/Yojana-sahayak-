# Copy to .env and fill in. Never commit .env.
# Local Postgres from docker-compose.yml:
DATABASE_URL="postgresql://yojana:yojana_local_only@localhost:5432/yojana_sahayak?schema=public"

# Anthropic API (server-side only). Leave blank to run in "AI unavailable" fallback mode.
ANTHROPIC_API_KEY=""
# Model name, e.g. the current Claude Sonnet model id from docs.claude.com
LLM_MODEL=""
# Daily cap on LLM calls per server instance (budget guard)
DAILY_LLM_REQUEST_LIMIT="500"

# Development only: show schemes still marked needs_verification on Explore,
# clearly labelled as drafts. Ignored in production. Chatbot and checker never use them.
SHOW_UNVERIFIED="false"
